# isonim's `ui` DSL unconditionally imports `isonim/dsl/tailwind`, which
# under the JS target hard-requires ../isonim/build/tailwind-styles.json
# at compile time (the C target tolerates it being absent). That file is
# generated by isonim's own Justfile, from the real Tailwind CLI over
# isonim's real source -- not something isonim-docs vendors or fakes.
# A clean checkout has no `../isonim/build/`, so every JS-target compile
# depends on this first.
tailwind-bootstrap:
    just --justfile ../isonim/Justfile --working-directory ../isonim build-tailwind

# Run the M0 + M1 + M2 suites on the JS target.
docs-test-js: tailwind-bootstrap
    nim js -r tests/docs/test_bootstrap_vm.nim
    nim js -r tests/docs/test_bootstrap_mock.nim
    nim js -r tests/docs/test_bootstrap_browser_mount.nim
    nim js -r tests/docs/test_routes_vm.nim
    nim js -r tests/docs/test_routes_mock.nim
