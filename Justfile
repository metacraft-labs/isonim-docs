# Run the full dual-target docs test matrix.
docs-test: docs-test-c docs-test-js

# Fast compile-only pass over both Layer-4 shell entry points (SSR +
# browser mount) on their real targets, against the real `content/`
# dir. Doesn't run anything -- it exists to catch "the proof route
# stopped compiling for real" regressions cheaply, without paying for
# the full dual-target test matrix on every save. `check_links` is the
# one exception: it's run for real (M3 deliverable 2's build gate), so a
# broken internal reference in the real content corpus fails this step
# with the offending file:line rather than shipping a dead link.
docs-smoke: tailwind-bootstrap
    nim c --compileOnly --hints:off src/ssr.nim
    nim js --compileOnly --hints:off src/main_web.nim
    nim c --compileOnly --hints:off src/cli.nim
    nim c -r --hints:off src/check_links.nim

# The single entry point a clean checkout uses: full test matrix plus
# the compile smoke, so a green `ci-docs` means both "the suites pass"
# and "the real shells still compile against real content".
ci-docs: docs-test docs-smoke

# --- M4 deliverable 5: production build (SSG) ---
# Statically generate the whole site into ./public via the shared renderRoute
# SSR path (one codebase -> SSG here, SSR via ssr.nim, SPA via main_web.nim).
docs-build: tailwind-bootstrap
    nim c -r --hints:off -o:build/build_site src/build_site.nim

# --- M11 deliverable 2: dev server ---
# Live-reloading dev server (HTTP + file watcher + websocket live-reload +
# a browser error overlay on build failure) over the checked-in mini-site
# fixture. A real consumer's dev entry constructs a DevServer over its own
# content dir; the CLI's `dev` subcommand (M11 deliverable 3) wraps this.
docs-dev:
    nim c -r --hints:off src/dev_server.nim

# --- M11 deliverable 3: CLI toolchain ---
# The `isonim-docs` binary: init/dev/build/serve subcommands, colored
# output, and flag/.env config overrides. A thin front-end over the same
# buildSite (SSG) and DevServer entry points the other recipes use.
docs-cli *ARGS:
    nim c --hints:off -o:build/isonim-docs src/cli.nim
    ./build/isonim-docs {{ARGS}}

# --- M4 deliverable 4: release gate ---
# A releasable candidate must pass every check with no hidden manual steps:
# full dual-target test suite (clean build + no broken links + search coverage
# + examples compile + SSR render + JS mount parity), the compile smoke, and a
# clean production build.
release-gate: docs-test docs-smoke docs-build
    @echo "RELEASE GATE PASSED: tests green (C+JS), smoke ok, site built to ./public"
