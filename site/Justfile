# isonim-docs/site -- task entry points for the framework's own docs site
# (mirrors ../../isonim/docs/users/Justfile's style).
#
# Every recipe assumes the IsoNim dev shell is active. From a clean
# checkout:
#   nix develop ../../isonim -c just --justfile site/Justfile --working-directory site build

test:
    nim c -r tests/test_site_builds.nim
    nim c -r tests/test_feature_coverage.nim
    nim c -r tests/test_doc_links_resolve.nim
    nim c -r tests/test_doc_examples_compile.nim
    nim c -r tests/test_dev.nim

build:
    nim c -r --hints:off -o:build/build src/build.nim

# Live-reloading docs server: serves content/ + themed assets and hot-reloads
# every open tab on any content edit. (`dev` is reserved for an app dev server;
# docs commands are namespaced `-docs` -- see metacraft-dev-guidelines
# repo-requirements.) Run this, then `just open-docs` in another shell.
dev-docs port='8000' host='127.0.0.1':
    nim c -r --hints:off src/dev.nim {{port}} {{host}}

# Live docs server bound to 0.0.0.0 for your private LAN (trusted networks only).
dev-docs-lan port='8000':
    @just dev-docs {{port}} 0.0.0.0

# Open the running docs server in a browser (Linux xdg-open / macOS open).
open-docs port='8000':
    @xdg-open http://localhost:{{port}}/ 2>/dev/null || open http://localhost:{{port}}/ 2>/dev/null || echo "open http://localhost:{{port}}/ manually"

# One-shot SSR docs preview (no live reload).
serve-docs:
    nim c -r --hints:off src/ssr.nim

# Launch the live design-system editor: an isonim editor instance over the
# Metacraft DTCG docs tokens (design/). Builds the client-side editor JS (the
# token set is staticRead-embedded) and SERVES it over HTTP via design/serve.nim
# so the editor's foundation "Save" can POST to the /__isonim_save route
# (same-origin) and persist the edit to codetracer-design-system/docs/
# codetracer-docs.tokens.json through the M4 writeback. Run `just dev-docs` in
# another shell to watch that saved edit hot-reload the live docs. Needs the
# isonim editor's extra sibling checkouts (see design/config.nims).
#
# (M4b changed this target: it now serves the editor over the dev server instead
# of opening design/index.html as a file:// -- required for the save `fetch` to
# reach the server same-origin. Build the bundle without serving via `just
# design-build`.)
design port='8080' host='127.0.0.1':
    nim js --hints:off -o:design/build/design_editor.js design/main.nim
    @echo "design editor on http://{{host}}:{{port}}/  (Ctrl-C to stop; run 'just dev-docs' in another shell to see saves hot-reload the docs)"
    nim c -r --hints:off design/serve.nim {{port}} {{host}}

# Build the design editor JS bundle only (no server) -- e.g. for the harness
# JS build check.
design-build:
    nim js --hints:off -o:design/build/design_editor.js design/main.nim
